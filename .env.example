# ========================================
# CONSTRUCTOR DE DOCUMENTOS SUMATE
# ========================================
NODE_ENV=production
PORT=3003
SERVICE_NAME=constructor-de-documentos-sumate

# ========================================
# SECRETO COMPARTIDO
# Con valor, toda peticion (salvo GET /health) debe traer la cabecera
# X-API-Key con este valor; si no, 401. Vacio = servicio abierto (solo para
# desarrollo local). Generar con: openssl rand -hex 32
# ========================================
CONSTRUCTOR_API_KEY=

# ========================================
# PLANTILLAS (xlsx, docx y mapfields csv)
# STORAGE_DRIVER=s3    -> bucket S3 compatible (MinIO en el 207)
# STORAGE_DRIVER=local -> directorio PLANTILLAS_DIR
# ========================================
STORAGE_DRIVER=s3
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=usuario_de_solo_lectura
MINIO_SECRET_KEY=clave_del_usuario
MINIO_REGION=us-east-1
MINIO_FORCE_PATH_STYLE=true
BUCKET_PLANTILLAS=plantillas-constructor
# Solo para saveToStorage=true (hoy nadie lo usa). Vacio = desactivado.
BUCKET_GENERADOS=
# MINIO_URL_PUBLICA=https://archivos.ejemplo.com
# PLANTILLAS_DIR=./plantillas
# GENERADOS_DIR=./generados

# ========================================
# SEGURIDAD DE DOCUMENTOS (solo formato expediente_sumate)
# ========================================
FRASE_SECRETA_EXCEL=

# ========================================
# LIMITES
# ========================================
MAX_BODY_SIZE=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# ========================================
# LOGGING (ERROR | WARN | INFO | DEBUG)
# ========================================
LOG_LEVEL=INFO

# ========================================
# SOLO PARA scripts/copiar-plantillas.js (lectura del bucket viejo)
# ========================================
# SUPABASE_URL=
# SUPABASE_KEY=
# SUPABASE_BUCKET=documentossumate
